# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------
# Conexión de la API en producción — el rol de aplicación (qolqa_app),
# SIN privilegios de superusuario y SIN BYPASSRLS. Es la única conexión
# que el servidor usa en tiempo de ejecución.
DATABASE_URL=postgres://qolqa_app:cambia-esto@localhost:5432/qolqa

# Conexión de administrador — dueña de las tablas. Solo la usa
# src/db/migrate.js para aplicar schema.sql y crear el rol de
# aplicación. Nunca se usa en el servidor (server.js no la lee).
DATABASE_URL_ADMIN=postgres://postgres:password@localhost:5432/qolqa

# Rol de aplicación que migrate.js crea si no existe, y contraseña con
# la que queda creado (debe coincidir con la de DATABASE_URL arriba).
DB_APP_ROLE=qolqa_app
DB_APP_PASSWORD=cambia-esto

# ---------------------------------------------------------------------
# Autenticación
# ---------------------------------------------------------------------
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
