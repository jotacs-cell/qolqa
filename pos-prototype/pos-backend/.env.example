# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------
DATABASE_URL=postgres://usuario:password@localhost:5432/pos_db

# ---------------------------------------------------------------------
# Autenticación
# ---------------------------------------------------------------------
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------
# Empresa emisora (datos tributarios básicos — ver también la tabla
# empresa_emisora en la base de datos para razón social, ubigeo, etc.)
# ---------------------------------------------------------------------
EMPRESA_RUC=20123456789

# ---------------------------------------------------------------------
# Envío a SUNAT vía NubeFacT (OSE homologado). NubeFacT arma el XML, lo
# firma con su propio certificado y lo envía a SUNAT — no necesitas
# certificado digital propio.
#
# Los obtienes en tu cuenta NubeFacT → Integración → API. Usa primero los
# de su entorno DEMO (no afectan tu facturación real) y recién cambia a
# los de producción cuando un envío de prueba salga aceptado.
# ---------------------------------------------------------------------
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

# ---------------------------------------------------------------------
# Búsqueda de RUC (apis.net.pe / Decolecta) — api.decolecta.com/v1/sunat/ruc.
# Token personal gratuito, generado en https://decolecta.com/profile.
# ---------------------------------------------------------------------
DECOLECTA_TOKEN=
