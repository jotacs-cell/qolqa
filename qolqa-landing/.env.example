# URL del sistema de ventas / ERP Qolqa al que apuntan los botones
# "Iniciar Sesión" y "Prueba Gratis" / "Comenzar Prueba de 24 hrs".
# Mientras el sistema no esté desplegado públicamente, quedan como rutas
# relativas (/login, /registro).
VITE_APP_LOGIN_URL=https://app.tudominio.pe/login
VITE_APP_SIGNUP_URL=https://app.tudominio.pe/registro

# Endpoint que recibe el formulario de leads del footer (nombre, teléfono,
# RUC). Debe ser un endpoint del backend (ej. qolqa-backend) con CORS
# habilitado para el dominio de este landing. Si se deja vacío, el
# formulario muestra un mensaje de error en vez de enviar datos a ningún lado.
VITE_LEADS_API_URL=https://api.tudominio.pe/leads

# Número de WhatsApp de ventas, en formato internacional sin "+" ni espacios.
VITE_WHATSAPP_NUMBER=51999999999
